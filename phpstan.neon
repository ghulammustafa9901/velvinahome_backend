includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Spec §12.1 targets level 8 on new code. The project starts at 8 so it never has to be
    # ratcheted up across 20 modules later.
    level: 8

    paths:
        - app
        - modules
        - tests/Support

    # Pest test files are closures bound to the test case at runtime; PHPStan sees `$this` as
    # a Pest TestCall and every assertion becomes a false positive. The shared test support
    # code is still analysed at level 8.
    excludePaths:
        analyseAndScan:
            - modules/*/database/migrations
            - tests/Support/Migrations
        analyse:
            - bootstrap/cache

    treatPhpDocTypesAsCertain: false
