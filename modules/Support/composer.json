{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "modules/support",
    "description": "Support module of the commerce platform.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Support\\Providers\\SupportServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
