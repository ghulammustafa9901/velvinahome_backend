# Placeholders only. Never commit a real credential (spec §8).
# Copy to .env for local development: cp .env.example .env && php artisan key:generate
#
# One installation = one store. Store identity (name, storefront URL, logo, currency, theme,
# feature flags, payment and courier credentials) is managed in the admin, not here. This file
# holds deployment configuration and secrets only.

APP_NAME="Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=json

# --- Hosts (ADR-0002). Empty = answer on any host. Production: admin.<domain>, api.<domain>
ADMIN_DOMAIN=

# --- Database: one PostgreSQL database per installation (database/setup/bootstrap-database.sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=store
DB_USERNAME=store_app
DB_PASSWORD=
DB_SSLMODE=prefer

# Migration role: owns the schema, used only by `php artisan app:migrate` during deploys.
DB_MIGRATOR_USERNAME=store_migrator
DB_MIGRATOR_PASSWORD=

# Migrations connect directly; application traffic goes through PgBouncer (transaction mode,
# PgBouncer >= 1.21 with max_prepared_statements > 0). Set wherever PgBouncer runs — the
# Compose stack (127.0.0.1:6432), staging, production. Empty = connect directly.
DB_POOLER_HOST=
DB_POOLER_PORT=6432

# --- Redis: cache, queues, sessions, rate limits --------------------------------------
# Two installations sharing one Redis server must use different prefixes.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=store:
CACHE_STORE=redis
REDIS_CLIENT=predis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_ENCRYPT=true
# Idle sign-out in minutes (ASVS 3.3.2); admin sessions also end after PANEL_MAX_SESSION_HOURS.
SESSION_LIFETIME=30
PANEL_MAX_SESSION_HOURS=12
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Search: Typesense (ADR-0005, ADR-0014) --------------------------------------------
# The collection is {SCOUT_PREFIX}products; installations sharing a Typesense server need
# different prefixes.
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
SCOUT_PREFIX=store_
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# --- Object storage: R2 in production, MinIO locally (ADR-0004) -----------------------
# Uploads go to the `media` (public) and `private` disks under OBJECT_STORAGE_PREFIX in the
# bucket. The default disk is only for framework scratch files.
FILESYSTEM_DISK=local
# s3 (R2 / MinIO) everywhere real; `local` only on a machine without MinIO (ADR-0009).
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_PREFIX=store
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=platform-local
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
# Public CDN base for media. Private files are served via signed, expiring URLs only.
R2_PUBLIC_URL=http://127.0.0.1:9000/platform-local

# --- Mail: Mailpit locally --------------------------------------------------------------
# The sender name and address customers see are store settings; these are the transport.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dev@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storefront BFF service authentication (ADR-0002, ADR-0003) -----------------------
# HMAC secret for the signed service header on Next.js -> API calls. It authenticates the
# caller only.
SERVICE_AUTH_SECRET=
SERVICE_AUTH_MAX_AGE_SECONDS=60
# Called when catalog/content/settings change so Next.js can purge ISR tags (spec §6.13).
STOREFRONT_REVALIDATE_SECRET=
# Install-time default for the store URL setting (links in emails, revalidation). Changed in
# the admin afterwards, under Settings → Store.
STOREFRONT_URL=

# --- Observability ----------------------------------------------------------------------
HORIZON_PREFIX=store-horizon

# --- Security ---------------------------------------------------------------------------
# Staff 2FA is mandatory (spec §6.2); this flag exists only to relax it in automated tests.
STAFF_2FA_REQUIRED=true

# --- Payments: merchant credentials are entered in the admin and stored encrypted in the
# --- database (spec §6.6). Nothing store-specific belongs in this file.
PAYMENTS_SANDBOX=true

# Error tracking (PostHog). Project key per environment; never commit it.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
MONITORING_ALERT_EMAIL=
HEALTH_CHECK_TOKEN=

# --- Backups (db:backup): PostgreSQL client tools (defaults: on PATH) ------------------
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
BACKUP_RETENTION=14
# Scratch database for the weekly restore drill (default: <DB_DATABASE>_restore_drill).
BACKUP_DRILL_DATABASE=

# Cloudflare Turnstile secret (empty = off). Pair with the storefront's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
