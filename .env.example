# Placeholders only. Never commit a real credential (spec §8).
# Copy to .env for local development: cp .env.example .env && php artisan key:generate

APP_NAME="Commerce Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://platform.localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=json

# --- Tenancy (spec §4) ---------------------------------------------------------------
# shared   = one installation serves many tenants, resolved by hostname
# dedicated = this installation serves exactly one tenant, pinned below
TENANCY_TOPOLOGY=shared
TENANCY_PINNED_TENANT=
# Platform (landlord) panel host. Unknown hosts 404; there is never a fallback tenant.
PLATFORM_HOST=platform.localhost

# --- Landlord database --------------------------------------------------------------
DB_CONNECTION=landlord
DB_LANDLORD_HOST=127.0.0.1
DB_LANDLORD_PORT=5432
DB_LANDLORD_DATABASE=platform_landlord
DB_LANDLORD_USERNAME=landlord_app
DB_LANDLORD_PASSWORD=
DB_LANDLORD_SSLMODE=prefer

# Migration role: used only by deploys, owns the schema.
DB_LANDLORD_MIGRATOR_USERNAME=landlord_migrator
DB_LANDLORD_MIGRATOR_PASSWORD=

# --- Tenant database provisioning ---------------------------------------------------
# The provisioner creates tenant databases and least-privilege roles. Not a superuser.
# In production these credentials come from the secret manager, not from this file.
DB_PROVISIONER_HOST=127.0.0.1
DB_PROVISIONER_PORT=5432
DB_PROVISIONER_USERNAME=platform_provisioner
DB_PROVISIONER_PASSWORD=
TENANT_DB_NAME_PREFIX=tenant_
TENANT_DB_ROLE_PREFIX=tenant_

# Migrations connect directly; application traffic goes through PgBouncer (transaction mode).
DB_POOLER_HOST=127.0.0.1
DB_POOLER_PORT=6432

# --- Redis: cache, queues, sessions, rate limits (tenant-prefixed) -----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
REDIS_CLIENT=predis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_ENCRYPT=true
# Idle sign-out in minutes (ASVS 3.3.2); panels also end after PANEL_MAX_SESSION_HOURS.
SESSION_LIFETIME=30
PANEL_MAX_SESSION_HOURS=12
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Search: Typesense, per-tenant collections (ADR-0005) -------------------------
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# --- Object storage: R2 in production, MinIO locally (ADR-0004) -------------------
# Tenant files always go through the tenant_media / tenant_private disks, which are
# prefixed per tenant. The default disk is only for framework scratch files.
FILESYSTEM_DISK=local
# s3 (R2 / MinIO) everywhere real; `local` only on a machine without MinIO (ADR-0009).
OBJECT_STORAGE_DRIVER=s3
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=platform-local
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
# Public CDN base for media. Private files are served via signed, expiring URLs only.
R2_PUBLIC_URL=http://127.0.0.1:9000/platform-local

# --- Mail: Mailpit locally; provider decided in Phase 3 (spec §16.3) --------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dev@platform.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storefront BFF service authentication (ADR-0002, ADR-0003) -------------------
# HMAC secret for the signed service header on Next.js -> API calls. It authenticates the
# caller only; the tenant is always resolved from the hostname, never from a header.
SERVICE_AUTH_SECRET=
SERVICE_AUTH_MAX_AGE_SECONDS=60
# Called when catalog/content/settings change so Next.js can purge ISR tags (spec §6.13).
STOREFRONT_REVALIDATE_SECRET=

# --- Observability -----------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PULSE_ENABLED=true
HORIZON_PREFIX=platform-horizon

# --- Security ----------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Staff 2FA is mandatory (spec §6.2); this flag exists only to relax it in automated tests.
STAFF_2FA_REQUIRED=true

# --- Payments: each tenant stores its own merchant credentials, encrypted in its own
# --- database (spec §6.6). Nothing tenant-specific belongs in this file.
PAYMENTS_SANDBOX=true

# --- Backups (spec §9) -------------------------------------------------------------
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=

# Error tracking (PostHog). Project key per environment; never commit it.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
MONITORING_ALERT_EMAIL=
HEALTH_CHECK_TOKEN=

# PostgreSQL client tools for tenant:export / tenant:restore (defaults: on PATH)
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
TENANT_EXPORT_RETENTION=14

# Cloudflare Turnstile secret (empty = off). Pair with the storefront's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
