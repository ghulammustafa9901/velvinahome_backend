{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "platform/platform-api",
    "type": "project",
    "description": "Multi-brand commerce platform: API, tenant admin, landlord panel, jobs.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.45",
        "filament/filament": "^5.8",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.6",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.3",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Support\\": "modules/Support/src/",
            "Modules\\Platform\\": "modules/Platform/src/",
            "Modules\\Identity\\": "modules/Identity/src/",
            "Modules\\Settings\\": "modules/Settings/src/",
            "Modules\\Integrations\\": "modules/Integrations/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint",
        "lint:check": "pint --test",
        "stan": "phpstan analyse",
        "test": "pest",
        "test:arch": "pest --group=architecture",
        "test:isolation": "pest --group=isolation",
        "test:coverage": "pest --coverage",
        "check": [
            "@lint:check",
            "@stan",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
