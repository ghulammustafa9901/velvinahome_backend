<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Architecture tests enforce the module boundaries and layering rules that a
             modular monolith depends on (spec §3.4). They run first and they are a required
             CI check. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
        </include>
        <exclude>
            <directory>modules/*/database</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- Real PostgreSQL, never SQLite: transactional DDL, jsonb, partial indexes and the
             append-only grants are PostgreSQL behaviour (ADR-0009). A separate database keeps
             test data apart from the local store on the same server. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="store_test"/>
        <env name="STOREFRONT_URL" value="http://store.test"/>
        <env name="OBJECT_STORAGE_DRIVER" value="local"/>
        <!-- Real Typesense; test collections are prefixed so they never touch dev ones. -->
        <env name="SCOUT_DRIVER" value="typesense"/>
        <env name="SCOUT_PREFIX" value="test_"/>

        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="POSTHOG_PROJECT_KEY" value=""/>
        <env name="HEALTH_CHECK_TOKEN" value="test-health-token-0123456789abcdef"/>

        <!-- Argon2id stays on (it is what production uses) with minimal cost for speed. -->
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>

        <env name="PASSWORD_BREACH_CHECK" value="false"/>
        <!-- Staff 2FA is mandatory in every real environment (spec §6.2); tests that are not
             about 2FA relax it so they do not all have to enrol a second factor. -->
        <env name="STAFF_2FA_REQUIRED" value="false"/>
    </php>
</phpunit>
